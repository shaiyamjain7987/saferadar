SECRET_KEY=super-secret-key-for-development
# Optional: override default instance/site.db
# DATABASE_URL=sqlite:///C:/path/to/site.db
# Vercel requires a hosted PostgreSQL DATABASE_URL for persistent data.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
# UPLOAD_FOLDER=/tmp/saferadar-uploads
# SEED_DEMO_DATA=1
WHISPER_MODEL=base
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_TRANSLATION_MODEL=gpt-4o-mini

# Exotel (India toll-free IVR)
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_SID=your_account_sid
# EXOTEL_VIRTUAL_NUMBER=1800xxxxxxx
# PUBLIC_BASE_URL=https://your-public-https-url

# Bhashini inference API
# BHASHINI_API_KEY=your-bhashini-api-key
# BHASHINI_ASR_LANGUAGE=auto
# BHASHINI_ASR_SERVICE_ID=
# BHASHINI_TRANSLATE_SERVICE_ID=
# IVR_WORKER_EMAIL=worker1@oil.com
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
